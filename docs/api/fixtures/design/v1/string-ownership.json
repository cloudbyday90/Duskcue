{
  "fixture": "string-ownership",
  "updated": "2026-07-02",
  "server_owned": [
    {
      "category": "media_metadata",
      "examples": [
        "movie title",
        "episode title",
        "overview",
        "collection name",
        "library name"
      ],
      "client_behavior": "display server value as provided; do not translate unless the server provides localized variants"
    },
    {
      "category": "problem_details",
      "examples": [
        "RFC 9457 title",
        "detail",
        "field validation message"
      ],
      "client_behavior": "display or map to client recovery copy without changing diagnostic meaning"
    },
    {
      "category": "notification_templates",
      "examples": [
        "download ready",
        "download failed",
        "trust alert",
        "new login"
      ],
      "client_behavior": "display rendered server notification text; use client copy only for surrounding actions"
    },
    {
      "category": "policy_state",
      "examples": [
        "admin-disabled downloads",
        "library policy denial",
        "quota denial"
      ],
      "client_behavior": "preserve server-owned denial reason and add client-owned recovery framing if useful"
    }
  ],
  "client_owned": [
