  "shared_key_reuse": [
    {
      "rule": "web_message_key_reference",
      "expectation": "Existing web message keys may guide future platform catalog naming, but native clients own generated/native resource files."
    },
    {
      "rule": "badge_label_keys",
      "expectation": "Badge keys from media-state-badges.json are stable shared contract keys and map to each client's localization files."
    },
    {
      "rule": "server_key_reuse",
      "expectation": "Server message/template keys can be referenced for display source attribution but must not be retranslated client-side unless server localization is absent and the flow explicitly permits client framing copy."
    },
    {
      "rule": "locale_activation",
      "expectation": "A platform locale is release-ready only when its client catalog, server-owned string behavior, accessibility labels, and RTL/layout review gates are complete."
    }
