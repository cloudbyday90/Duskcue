{
  "fixture": "auth-flow-matrix",
  "flows": [
    {
      "id": "device_linking",
      "steps": [
        {
          "request": {
            "method": "POST",
            "path": "/api/v1/device/code"
          },
          "expect": {
            "device_code": "fixture-device-code",
            "user_code": "ABCD-EFGH",
            "verification_uri": "https://duskcue.example.test/auth/link",
            "verification_uri_complete": "https://duskcue.example.test/auth/link?code=ABCD-EFGH",
            "expires_in": 600,
            "interval": 5
          }
        },
        {
          "request": {
            "method": "POST",
            "path": "/api/v1/device/token"
          },
          "expect_pending": {
            "status": 428,
            "title": "AUTH_023"
          }
        },
        {
          "request": {
            "method": "POST",
            "path": "/api/v1/device/token"
          },
          "expect_success": {
            "token_placeholder": "fixture-token-not-secret",
            "user_id": "aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaaaaaa",
            "active_profile_id": "abababab-abab-4bab-8bab-abababababab"
          }
        }
      ],
      "client_requirements": [
        "poll no faster than interval_seconds",
        "increase the interval by five seconds after AUTH_024 and honor Retry-After",
        "show verification_uri_complete only as a shortcut while still displaying user_code",
        "resume original deep link after success",
        "do not display device_code as a reusable secret"
      ]
    },
    {
      "id": "passkey_login",
      "steps": [
        {
          "request": {
            "method": "POST",
            "path": "/api/v1/auth/webauthn/start"
          },
          "expect": {
            "challenge_id": "challenge-passkey-login",
            "rp_id": "duskcue.example.test",
            "user_verification": "preferred"
          }
        },
        {
          "request": {
            "method": "POST",
            "path": "/api/v1/auth/webauthn/finish"
          },
          "expect_success": {
            "session_id": "abababab-abab-4bab-8bab-abababababab",
            "token_placeholder": "fixture-token-not-secret",
            "user_id": "aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaaaaaa"
          }
        }
      ],
      "client_requirements": [
        "scope credential requests to the selected server origin",
        "preserve challenge_id only until finish or expiry",
        "fall back only when passkey is unsupported or unavailable"
      ]
    },
    {
      "id": "fallback_login",
      "steps": [
        {
          "request": {
            "method": "POST",
            "path": "/api/v1/auth/login"
          },
          "expect_success": {
            "session_id": "abababab-abab-4bab-8bab-abababababab",
            "token_placeholder": "fixture-token-not-secret",
            "client_platform": "android"
          }
        }
      ],
      "client_requirements": [
        "send stable client metadata",
        "store the resulting bearer token only in platform secure storage",
        "rate-limit visible retry loops after auth failure"
      ]
    },
    {
      "id": "profile_selection",
      "steps": [
        {
          "request": {
            "method": "POST",
            "path": "/api/v1/auth/login"
          },
          "expect_success": {
            "user_id": "aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaaaaaa",
            "active_profile_id": "abababab-abab-4bab-8bab-abababababab",
            "profile_selection_required": true
          }
        },
        {
          "request": {
            "method": "GET",
            "path": "/api/v1/profiles"
          },
          "expect": {
            "active_profile_id": "abababab-abab-4bab-8bab-abababababab",
            "profile_selection_required": true,
            "remembered_profile_id": null,
            "device_can_remember_profile": true
          }
        },
        {
          "request": {
            "method": "POST",
            "path": "/api/v1/profiles/cdcdcdcd-cdcd-4dcd-8dcd-cdcdcdcdcdcd/switch"
          },
          "expect_success": {
            "active_profile_id": "cdcdcdcd-cdcd-4dcd-8dcd-cdcdcdcdcdcd",
            "profile_selection_required": false,
            "remembered_profile_id": "cdcdcdcd-cdcd-4dcd-8dcd-cdcdcdcdcdcd"
          }
        }
      ],
      "client_requirements": [
        "do not mount profile-scoped rows while profile_selection_required is true",
        "allow an explicit current-session selection even when remember_on_device is false",
        "clear profile-scoped requests and cached previews before rendering the selected profile",
        "revalidate the local session after a same-origin profile-change notification"
      ]
    },
    {
      "id": "parent_unlock",
      "steps": [
        {
          "request": {
            "method": "GET",
            "path": "/api/v1/profiles"
          },
          "expect": {
            "active_profile_id": "abababab-abab-4bab-8bab-abababababab",
            "parent_unlock_required": true,
            "parent_unlock_expires_at": null,
            "items_include_parent_pin_configured": true
          }
        },
        {
          "request": {
            "method": "POST",
            "path": "/api/v1/profiles/parent-unlock"
          },
          "expect_problem": {
            "status": 403,
            "title": "PROFILE_010"
          }
        },
        {
          "request": {
            "method": "POST",
            "path": "/api/v1/profiles/parent-unlock"
          },
          "expect_success": {
            "unlocked_until": "2026-07-18T16:10:00Z"
          }
        },
        {
          "request": {
            "method": "POST",
            "path": "/api/v1/profiles/cdcdcdcd-cdcd-4dcd-8dcd-cdcdcdcdcdcd/switch"
          },
          "expect_success": {
            "active_profile_id": "cdcdcdcd-cdcd-4dcd-8dcd-cdcdcdcdcdcd",
            "parent_unlock_required": false,
            "parent_unlock_expires_at": null
          }
        }
      ],
      "client_requirements": [
        "show parent PIN only in a transient local prompt",
        "never persist or publish the parent PIN",
        "require a successful server unlock before selecting a standard profile from a locked Kids profile",
        "clear parent-unlock UI state after a profile switch"
      ]
    },
    {
      "id": "reauth",
      "steps": [
        {
          "request": {
            "method": "POST",
            "path": "/api/v1/auth/reauth/request"
          },
          "expect": {
            "prefix": "ABCD",
            "expires_at": "2026-07-01T13:00:00Z"
          }
        },
        {
          "request": {
            "method": "POST",
            "path": "/api/v1/auth/reauth"
          },
          "expect_success": {
            "session_id": "cdcdcdcd-cdcd-4dcd-8dcd-cdcdcdcdcdcd",
            "token_placeholder": "fixture-token-not-secret"
          }
        }
      ],
      "client_requirements": [
        "use reauth for sensitive account actions",
        "replace the local session token after success",
        "clear the reauth code after success or expiry"
      ]
    }
  ]
}
