{
  "fixture": "ci-release-placeholders",
  "policy": {
    "secrets_rule": "Signing keys, certificates, provisioning profiles, app-store API credentials, package passwords, and notarization credentials must be stored only as CI secrets or secure key-vault references.",
    "artifact_rule": "Every release-channel build must publish a named artifact, checksum, SBOM, and provenance record before release promotion.",
    "manual_gate_rule": "Stable releases require manual approval plus release-required device evidence from the device lab pack."
  },
  "jobs": [
    {
      "platform": "android_mobile",
      "artifact": "duskcue-android-mobile.aab",
      "build_command": "flutter build appbundle --release",
      "signing_hook": "android-upload-keystore-ci-secret",
      "notarization_hook": "play-app-signing",
      "sbom": "spdx-or-cyclonedx-android-mobile.json",
      "provenance": "github-artifact-attestation",
      "release_channel": "internal"
    },
    {
      "platform": "ios_mobile",
      "artifact": "duskcue-ios-mobile.ipa",
      "build_command": "flutter build ipa --release",
      "signing_hook": "apple-distribution-certificate-ci-secret",
      "notarization_hook": "app-store-connect-processing",
      "sbom": "spdx-or-cyclonedx-ios-mobile.json",
      "provenance": "github-artifact-attestation",
      "release_channel": "beta"
    },
    {
      "platform": "windows_desktop",
      "artifact": "duskcue-desktop-windows.msi",
