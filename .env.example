DUSKCUE_IMAGE=ghcr.io/duskcue/duskcue:latest
DUSKCUE_HOST_BIND=0.0.0.0
DUSKCUE_BIND_ADDRESS=0.0.0.0
DUSKCUE_PORT=48027
DUSKCUE_LOG_LEVEL=info
DUSKCUE_ENVIRONMENT=production
DUSKCUE_PUBLIC_URL=

# Leave unset for embedded PostgreSQL.
# DUSKCUE_DATABASE_URL=postgresql://duskcue:password@db-host:5432/duskcue

TV_PATH=/path/to/tv
MOVIES_PATH=/path/to/movies
# MUSIC_PATH=/path/to/music

PUID=1000
PGID=1000
TZ=Etc/UTC
TRANSCODE_TMPFS_SIZE=2G
