ARG RUST_IMAGE=rust:alpine3.24@sha256:f87aa870663e2b57ec8c69de82c7eedf7383bee987eef7612c0359635eaadb41
ARG RUNTIME_IMAGE=duskcue:local

FROM ${RUST_IMAGE} AS compiler-tools
ARG RUST_IMAGE
ARG TARGETPLATFORM
WORKDIR /src
RUN apk add --no-cache build-base clang cmake linux-headers perl pkgconf protobuf-dev jq
COPY docker/qualification/compile-cache.sh /usr/local/libexec/duskcue-compile-cache.sh
COPY docker/qualification/cargo-artifact.sh /usr/local/libexec/duskcue-cargo-artifact.sh
COPY docker/qualification/Dockerfile.recovery /usr/local/libexec/duskcue-recovery.Dockerfile

FROM compiler-tools AS cache-qualification
COPY docker/qualification/compile-cache.test.sh /usr/local/libexec/duskcue-compile-cache.test.sh
ENV NATIVE_RECOVERY_MODE=none VOD_OUTPUT_MODE=none FORMAT_CORPUS_MODE=none SOURCE_CAPABILITIES_MODE=none
RUN sh /usr/local/libexec/duskcue-compile-cache.test.sh > /tmp/compile-cache-tests.log 2>&1 \
    && test "$(wc -c < /tmp/compile-cache-tests.log)" -le 65536 \
    || { cat /tmp/compile-cache-tests.log >&2; exit 1; }

FROM compiler-tools AS compiler
COPY Cargo.toml Cargo.lock ./
COPY vendor ./vendor
COPY crates ./crates
COPY server ./server
COPY clients/desktop/src-tauri ./clients/desktop/src-tauri
COPY native/ffmpeg-bootstrap ./native/ffmpeg-bootstrap
COPY --from=cache-qualification /tmp/compile-cache-tests.log /tmp/qualification-evidence/compile-cache-tests.log
ARG NATIVE_RECOVERY_MODE=none
ARG VOD_OUTPUT_MODE=none
ARG FORMAT_CORPUS_MODE=none
ARG SOURCE_CAPABILITIES_MODE=none
RUN case "$SOURCE_CAPABILITIES_MODE" in none) ;; exact) test "$FORMAT_CORPUS_MODE" = reference && test "$NATIVE_RECOVERY_MODE" = paced ;; *) exit 1 ;; esac
RUN --mount=type=cache,target=/usr/local/cargo/registry,sharing=locked \
    --mount=type=cache,target=/usr/local/cargo/git,sharing=locked \
    --mount=type=cache,id=duskcue-recovery-v1-${TARGETPLATFORM},target=/src/target,sharing=locked \
    sh /usr/local/libexec/duskcue-compile-cache.sh \
    && case "$NATIVE_RECOVERY_MODE" in none) set -- ;; paced) set -- --features duskcue/playback-qualification ;; *) exit 1 ;; esac \
    && (cargo test --release --locked -p duskcue -j 2 --test playback_stop_contract --no-run --message-format=json "$@" > /tmp/playback-cargo-artifacts.jsonl \
    || { jq -r 'select(.reason == "compiler-message") | .message.rendered // empty' /tmp/playback-cargo-artifacts.jsonl >&2; exit 1; }) \
    && sh /usr/local/libexec/duskcue-cargo-artifact.sh /tmp/playback-cargo-artifacts.jsonl playback_stop_contract "$NATIVE_RECOVERY_MODE" /tmp/playback-stop-contract
RUN --mount=type=cache,target=/usr/local/cargo/registry,sharing=locked \
    --mount=type=cache,target=/usr/local/cargo/git,sharing=locked \
    --mount=type=cache,id=duskcue-recovery-v1-${TARGETPLATFORM},target=/src/target,sharing=locked \
    sh /usr/local/libexec/duskcue-compile-cache.sh \
    && case "$NATIVE_RECOVERY_MODE" in none) set -- ;; paced) set -- --features duskcue/playback-qualification ;; *) exit 1 ;; esac \
    && case "$VOD_OUTPUT_MODE" in \
        none) ;; \
        owned) (cargo test --release --locked -p duskcue -j 2 --lib --no-run --message-format=json "$@" > /tmp/vod-cargo-artifacts.jsonl \
            || { jq -r 'select(.reason == "compiler-message") | .message.rendered // empty' /tmp/vod-cargo-artifacts.jsonl >&2; exit 1; }) \
            && sh /usr/local/libexec/duskcue-cargo-artifact.sh /tmp/vod-cargo-artifacts.jsonl duskcue "$NATIVE_RECOVERY_MODE" /tmp/qualification-evidence/vod-lib-tests ;; \
        *) exit 1 ;; \
    esac
RUN --mount=type=cache,target=/usr/local/cargo/registry,sharing=locked \
    --mount=type=cache,target=/usr/local/cargo/git,sharing=locked \
    --mount=type=cache,id=duskcue-recovery-v1-${TARGETPLATFORM},target=/src/target,sharing=locked \
    sh /usr/local/libexec/duskcue-compile-cache.sh \
    && case "$NATIVE_RECOVERY_MODE" in none) set -- ;; paced) set -- --features duskcue/playback-qualification ;; *) exit 1 ;; esac \
    && case "$VOD_OUTPUT_MODE" in \
        none) ;; \
        owned) (cargo test --release --locked -p duskcue -j 2 --test playback_retention --no-run --message-format=json "$@" > /tmp/retention-cargo-artifacts.jsonl \
            || { jq -r 'select(.reason == "compiler-message") | .message.rendered // empty' /tmp/retention-cargo-artifacts.jsonl >&2; exit 1; }) \
            && sh /usr/local/libexec/duskcue-cargo-artifact.sh /tmp/retention-cargo-artifacts.jsonl playback_retention "$NATIVE_RECOVERY_MODE" /tmp/qualification-evidence/playback-retention ;; \
        *) exit 1 ;; \
    esac
RUN --mount=type=cache,target=/usr/local/cargo/registry,sharing=locked \
    --mount=type=cache,target=/usr/local/cargo/git,sharing=locked \
    --mount=type=cache,id=duskcue-recovery-v1-${TARGETPLATFORM},target=/src/target,sharing=locked \
    sh /usr/local/libexec/duskcue-compile-cache.sh \
    && case "$NATIVE_RECOVERY_MODE" in none) set -- ;; paced) set -- --features duskcue/playback-qualification ;; *) exit 1 ;; esac \
    && if [ "$NATIVE_RECOVERY_MODE" = paced ]; then \
        cargo test --release --locked -p duskcue -j 2 --lib "$@" services::transcoding::qualification::tests:: -- --test-threads=1 > /tmp/qualification-evidence/pacing-unit-tests.log \
        || { cat /tmp/qualification-evidence/pacing-unit-tests.log >&2; exit 1; }; \
        test "$(wc -c < /tmp/qualification-evidence/pacing-unit-tests.log)" -le 65536 || exit 1; \
    fi \
    && case "$FORMAT_CORPUS_MODE" in \
        none) ;; \
        reference) test "$NATIVE_RECOVERY_MODE" = paced \
            && cargo test --release --locked -p duskcue -j 2 --test playback_stop_contract "$@" '::formats::' -- --test-threads=1 > /tmp/qualification-evidence/format-unit-tests.log \
            || { cat /tmp/qualification-evidence/format-unit-tests.log >&2; exit 1; }; \
            test "$(wc -c < /tmp/qualification-evidence/format-unit-tests.log)" -le 65536 || exit 1 ;; \
        *) exit 1 ;; \
    esac
RUN --mount=type=cache,target=/usr/local/cargo/registry,sharing=locked \
    --mount=type=cache,target=/usr/local/cargo/git,sharing=locked \
    --mount=type=cache,id=duskcue-recovery-v1-${TARGETPLATFORM},target=/src/target,sharing=locked \
    sh /usr/local/libexec/duskcue-compile-cache.sh \
    && if [ "$SOURCE_CAPABILITIES_MODE" = exact ]; then \
        for selector in services::source_capabilities::tests:: workers::library_scanner::probe::capabilities::tests:: \
            workers::library_scanner::scan_diff::tests:: domains::playback::source_candidates::tests:: \
            domains::playback::direct_admission::tests:: \
            domains::playback::source_freshness::tests:: domains::playback::copy_recovery::tests:: \
            domains::playback::source_types::tests:: \
            domains::playback::file_delivery::tests:: domains::playback::range::tests:: \
            services::transcoding::readiness::source_origin::tests:: \
            services::transcoding::output_profile::source_copy::tests:: extractors::credential_transport_tests::; do \
            cargo test --release --locked -p duskcue -j 2 --features duskcue/playback-qualification --lib "$selector" -- --test-threads=1 > /tmp/source-group.log \
                || { cat /tmp/source-group.log >&2; exit 1; }; \
            grep -Eq '^test result: ok\. [1-9][0-9]* passed; 0 failed; 0 ignored;' /tmp/source-group.log || { cat /tmp/source-group.log >&2; exit 1; }; \
            cat /tmp/source-group.log >> /tmp/qualification-evidence/source-unit-tests.log; \
        done; \
        test "$(wc -c < /tmp/qualification-evidence/source-unit-tests.log)" -le 65536 || exit 1; \
    fi

FROM ${RUNTIME_IMAGE} AS runtime
ARG SOURCE_SHA256
ARG RUNTIME_BASE_ID
ARG NATIVE_RECOVERY_MODE=none
ARG VOD_OUTPUT_MODE=none
ARG FORMAT_CORPUS_MODE=none
ARG SOURCE_CAPABILITIES_MODE=none
LABEL duskcue.qualification.kind="local-playback-recovery-v1" \
      duskcue.qualification.source-sha256="${SOURCE_SHA256}" \
      duskcue.qualification.runtime-base-id="${RUNTIME_BASE_ID}" \
      duskcue.qualification.vod-output="${VOD_OUTPUT_MODE}" \
      duskcue.qualification.native-recovery="${NATIVE_RECOVERY_MODE}" \
      duskcue.qualification.format-corpus="${FORMAT_CORPUS_MODE}" \
      duskcue.qualification.source-capabilities="${SOURCE_CAPABILITIES_MODE}"
USER root
RUN mkdir -p /qualification/bin /src/.cache/tonight-server-ffmpeg /src/.cache/tonight-server-stop \
    && chown 65532:65532 /src/.cache/tonight-server-stop
COPY --from=compiler /tmp/playback-stop-contract /qualification/bin/playback-stop-contract
COPY --from=compiler /tmp/playback-stop-contract.sha256 /qualification/bin/playback-stop-contract.sha256
COPY --from=compiler /tmp/playback-cargo-artifacts.jsonl /qualification/cargo-artifacts.jsonl
COPY --from=compiler /tmp/qualification-evidence /qualification/evidence
COPY docker/qualification/recovery-fixture.mjs /qualification/recovery-fixture.mjs
COPY docker/qualification/direct-http-bridge.mjs /qualification/direct-http-bridge.mjs
COPY docker/qualification/direct-http-policy.mjs /qualification/direct-http-policy.mjs
COPY docker/qualification/direct-native-control.mjs /qualification/direct-native-control.mjs
COPY docker/qualification/direct-format-control.mjs /qualification/direct-format-control.mjs
COPY docker/qualification/format-*.mjs /qualification/docker/qualification/
COPY scripts/qualification/format-codecs.mjs /qualification/scripts/qualification/format-codecs.mjs
RUN (cd /qualification/bin && sha256sum -c playback-stop-contract.sha256) \
    && if [ "$VOD_OUTPUT_MODE" = owned ]; then (cd /qualification/evidence && sha256sum -c vod-lib-tests.sha256 && sha256sum -c playback-retention.sha256); fi \
    && sha256sum -c /usr/local/libexec/duskcue-ffmpeg.sha256 \
    && node --max-old-space-size=64 /qualification/recovery-fixture.mjs \
    && chmod 0555 /qualification/bin/playback-stop-contract \
    && if [ "$VOD_OUTPUT_MODE" = owned ]; then chmod 0555 /qualification/evidence/vod-lib-tests /qualification/evidence/playback-retention; fi \
    && chmod 0444 /src/.cache/tonight-server-ffmpeg/* /qualification/cargo-artifacts.jsonl
RUN case "$FORMAT_CORPUS_MODE" in \
        none) ;; \
        reference) test "$NATIVE_RECOVERY_MODE" = paced \
            && (node --max-old-space-size=64 --test --test-concurrency=1 --test-reporter=tap /qualification/docker/qualification/format-process.test.mjs > /qualification/evidence/format-process-tests.log \
                || { cat /qualification/evidence/format-process-tests.log >&2; exit 1; }) \
            && node --max-old-space-size=64 /qualification/docker/qualification/format-corpus.mjs --directory /qualification/format-sources \
            && chmod 0555 /qualification/format-sources \
            && chmod 0444 /qualification/format-sources/* \
            && chmod 0444 /qualification/format-corpus.json ;; \
        *) exit 1 ;; \
    esac
ENV HOME=/tmp \
    DUSKCUE_TEST_FFMPEG_MODE=linux-local-managed \
    DUSKCUE_TEST_PLAYBACK_SOURCE=/src/.cache/tonight-server-ffmpeg/source.mkv \
    DUSKCUE_TEST_PROGRESSIVE_PLAYBACK=event \
    DUSKCUE_TRANSCODE_ACCESS_TESTS=disposable \
    RUST_TEST_THREADS=1
USER 65532:65532
WORKDIR /qualification
HEALTHCHECK NONE
ENTRYPOINT ["/qualification/bin/playback-stop-contract"]
CMD ["stop_is_idempotent_serializes_heartbeat_seek_and_retains_original_profile", "--exact", "--include-ignored", "--nocapture"]
