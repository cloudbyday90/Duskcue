ARG RUST_IMAGE=rust:alpine3.24@sha256:f87aa870663e2b57ec8c69de82c7eedf7383bee987eef7612c0359635eaadb41
ARG RUNTIME_IMAGE=duskcue:local

FROM ${RUST_IMAGE} AS compiler
WORKDIR /src
RUN apk add --no-cache build-base clang cmake linux-headers perl pkgconf protobuf-dev jq
COPY Cargo.toml Cargo.lock ./
COPY vendor ./vendor
COPY crates ./crates
COPY server ./server
COPY clients/desktop/src-tauri ./clients/desktop/src-tauri
COPY native/ffmpeg-bootstrap ./native/ffmpeg-bootstrap
ARG NATIVE_RECOVERY_MODE=none
RUN --mount=type=cache,target=/usr/local/cargo/registry \
    --mount=type=cache,target=/usr/local/cargo/git \
    --mount=type=cache,target=/src/target \
    case "$NATIVE_RECOVERY_MODE" in none) set -- ;; paced) set -- --features duskcue/playback-qualification ;; *) exit 1 ;; esac \
    && (cargo test --release --locked -p duskcue -j 2 --test playback_stop_contract --no-run --message-format=json "$@" > /tmp/playback-cargo-artifacts.jsonl \
    || { jq -r 'select(.reason == "compiler-message") | .message.rendered // empty' /tmp/playback-cargo-artifacts.jsonl >&2; exit 1; }) \
    && executable="$(jq -ers '[.[] | select(.reason == "compiler-artifact" and .target.name == "playback_stop_contract" and .profile.test == true) | .executable | select(. != null)] | unique | select(length == 1) | .[0]' /tmp/playback-cargo-artifacts.jsonl)" \
    && case "$executable" in /src/target/release/deps/playback_stop_contract-*) test -x "$executable" ;; *) exit 1 ;; esac \
    && jq -es --arg mode "$NATIVE_RECOVERY_MODE" 'any(.[]; .reason == "compiler-artifact" and .target.name == "playback_stop_contract" and .profile.test == true and (((.features // []) | index("playback-qualification") != null) == ($mode == "paced")))' /tmp/playback-cargo-artifacts.jsonl >/dev/null \
    && cp "$executable" /tmp/playback-stop-contract \
    && mkdir -p /tmp/qualification-evidence \
    && if [ "$NATIVE_RECOVERY_MODE" = paced ]; then \
        cargo test --release --locked -p duskcue -j 2 --lib "$@" services::transcoding::qualification::tests:: -- --test-threads=1 > /tmp/qualification-evidence/pacing-unit-tests.log \
        || { cat /tmp/qualification-evidence/pacing-unit-tests.log >&2; exit 1; }; \
        test "$(wc -c < /tmp/qualification-evidence/pacing-unit-tests.log)" -le 65536 || exit 1; \
    fi

FROM ${RUNTIME_IMAGE} AS runtime
ARG SOURCE_SHA256
ARG RUNTIME_BASE_ID
ARG NATIVE_RECOVERY_MODE=none
LABEL duskcue.qualification.kind="local-playback-recovery-v1" \
      duskcue.qualification.source-sha256="${SOURCE_SHA256}" \
      duskcue.qualification.runtime-base-id="${RUNTIME_BASE_ID}" \
      duskcue.qualification.native-recovery="${NATIVE_RECOVERY_MODE}"
USER root
RUN mkdir -p /qualification/bin /src/.cache/tonight-server-ffmpeg /src/.cache/tonight-server-stop \
    && chown 65532:65532 /src/.cache/tonight-server-stop
COPY --from=compiler /tmp/playback-stop-contract /qualification/bin/playback-stop-contract
COPY --from=compiler /tmp/playback-cargo-artifacts.jsonl /qualification/cargo-artifacts.jsonl
COPY --from=compiler /tmp/qualification-evidence /qualification/evidence
COPY docker/qualification/recovery-fixture.mjs /qualification/recovery-fixture.mjs
COPY docker/qualification/direct-http-bridge.mjs /qualification/direct-http-bridge.mjs
COPY docker/qualification/direct-http-policy.mjs /qualification/direct-http-policy.mjs
COPY docker/qualification/direct-native-control.mjs /qualification/direct-native-control.mjs
RUN sha256sum -c /usr/local/libexec/duskcue-ffmpeg.sha256 \
    && node --max-old-space-size=64 /qualification/recovery-fixture.mjs \
    && chmod 0555 /qualification/bin/playback-stop-contract \
    && chmod 0444 /src/.cache/tonight-server-ffmpeg/* /qualification/cargo-artifacts.jsonl
ENV HOME=/tmp \
    DUSKCUE_TEST_FFMPEG_MODE=linux-local-managed \
    DUSKCUE_TEST_PLAYBACK_SOURCE=/src/.cache/tonight-server-ffmpeg/source.mkv \
    DUSKCUE_TEST_PROGRESSIVE_PLAYBACK=event \
    DUSKCUE_TRANSCODE_ACCESS_TESTS=disposable \
    RUST_TEST_THREADS=1
USER 65532:65532
WORKDIR /qualification
HEALTHCHECK NONE
ENTRYPOINT ["/qualification/bin/playback-stop-contract"]
CMD ["stop_is_idempotent_serializes_heartbeat_seek_and_retains_original_profile", "--exact", "--include-ignored", "--nocapture"]
