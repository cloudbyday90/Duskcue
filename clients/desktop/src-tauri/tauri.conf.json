{
    "$schema": "https://schema.tauri.app/config/2",
    "productName": "Duskcue",
    "version": "0.1.0",
    "identifier": "com.duskcue.desktop",
    "build": {
        "beforeDevCommand": "npm run dev",
        "devUrl": "http://localhost:5173",
        "beforeBuildCommand": "npm run build",
        "frontendDist": "../../web/build/client"
    },
    "app": {
        "windows": [
            {
                "label": "main",
                "title": "Duskcue",
                "width": 1280,
                "height": 720,
                "minWidth": 960,
                "minHeight": 600,
                "resizable": true,
                "decorations": true
            }
        ],
        "security": {
            "csp": null
        }
    },
    "plugins": {
        "deep-link": {
            "desktop": {
                "schemes": [
                    "duskcue"
                ]
            }
        }
    }
}
