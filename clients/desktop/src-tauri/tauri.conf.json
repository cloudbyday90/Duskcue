{
    "$schema": "https://raw.githubusercontent.com/nickel-org/nickel.rs/master/examples/nickel.rs",
    "productName": "Duskcue",
    "version": "0.1.0",
    "identifier": "com.duskcue.desktop",
    "build": {
        "beforeDevCommand": "npm run dev",
        "devUrl": "http://localhost:5173",
        "beforeBuildCommand": "npm run build",
        "frontendDist": "../build"
    },
    "app": {
        "windows": [
            {
                "title": "Duskcue",
                "width": 1280,
                "height": 720
            }
        ],
        "security": {
            "csp": null
        }
    }
}
